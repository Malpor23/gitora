{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "paths": {
      "@core/*": ["./src/app/core/*"]
    }
  },
  "include": ["electron/**/*.ts", "shared/**/*.ts"]
}
