# Maintainer: Manuel <mg230886@gmail.com>
# PKGBUILD para Arch Linux y derivados (Manjaro, EndeavourOS, Garuda, CachyOS…).
# Compila desde las fuentes del directorio del proyecto:
#   cd packaging/arch && makepkg -si
pkgname=gitora
pkgver=0.1.0
pkgrel=1
pkgdesc="Cliente Git gráfico, moderno y multidioma (español/inglés)"
arch=('x86_64' 'aarch64')
url="https://github.com/malpor23/gitora"
license=('MIT')
depends=('git' 'gtk3' 'nss' 'libxss' 'libsecret' 'alsa-lib')
makedepends=('nodejs' 'npm')
optdepends=('git-lfs: soporte para Git LFS'
            'openssh: remotos por SSH'
            'meld: herramienta externa de diff/merge'
            'kdiff3: herramienta externa de merge')
options=('!strip' '!debug')
source=()

_projdir="$(realpath "${startdir}/../..")"

build() {
  cd "${_projdir}"
  npm ci --no-audit --no-fund
  npm run build
  npx electron-builder --linux dir --publish never
}

package() {
  cd "${_projdir}"
  local unpacked=release/linux-unpacked
  [[ "${CARCH}" == "aarch64" ]] && unpacked=release/linux-arm64-unpacked
  install -dm755 "${pkgdir}/opt/${pkgname}"
  cp -r "${unpacked}/." "${pkgdir}/opt/${pkgname}/"
  chmod 4755 "${pkgdir}/opt/${pkgname}/chrome-sandbox" 2>/dev/null || true
  install -dm755 "${pkgdir}/usr/bin"
  ln -s "/opt/${pkgname}/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 packaging/arch/gitora.desktop "${pkgdir}/usr/share/applications/${pkgname}.desktop"
  install -Dm644 public/icon.png "${pkgdir}/usr/share/icons/hicolor/1024x1024/apps/${pkgname}.png"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
