# Maintainer: Manuel Gomez <mg230886@gmail.com>
# PKGBUILD para el AUR: compila Gitora desde el tag de GitHub.
#   yay -S gitora    (o: paru -S gitora)
# Necesita red durante build(): npm ci descarga las dependencias y electron-builder el binario de Electron.
pkgname=gitora
pkgver=0.1.2
pkgrel=1
pkgdesc="Graphical, modern, multilingual Git client (Spanish/English)"
arch=('x86_64' 'aarch64')
url="https://github.com/Malpor23/gitora"
license=('MIT')
depends=('git' 'gtk3' 'nss' 'libxss' 'libsecret' 'alsa-lib')
makedepends=('nodejs' 'npm')
optdepends=('git-lfs: Git LFS support'
            'openssh: SSH remotes'
            'meld: external diff/merge tool'
            'kdiff3: external merge tool')
options=('!strip' '!debug')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP') # reemplazar con `updpkgsums` una vez publicado el tag

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  npm ci --no-audit --no-fund
  npm run build
  npx electron-builder --linux dir --publish never
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  local unpacked=release/linux-unpacked
  [[ "${CARCH}" == "aarch64" ]] && unpacked=release/linux-arm64-unpacked
  install -dm755 "${pkgdir}/opt/${pkgname}"
  cp -r "${unpacked}/." "${pkgdir}/opt/${pkgname}/"
  chmod 4755 "${pkgdir}/opt/${pkgname}/chrome-sandbox"
  install -dm755 "${pkgdir}/usr/bin"
  ln -s "/opt/${pkgname}/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 packaging/arch/gitora.desktop "${pkgdir}/usr/share/applications/${pkgname}.desktop"
  for size in 16 24 32 48 64 128 256 512 1024; do
    install -Dm644 "packaging/icons/${size}x${size}.png" "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/${pkgname}.png"
  done
  install -Dm644 packaging/icons/gitora.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${pkgname}.svg"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
